{
  "name": "sanity-template-nextjs-clean",
  "description": "Next.js + Sanity: A Powerful Website Starter with Real-time Visual Editing",
  "keywords": [
    "Sanity",
    "Next.js",
    "Headless CMS",
    "Visual Editing",
    "Live Content API (LCAPI)",
    "Real-time"
  ],
  "homepage": "https://github.com/sanity-io/sanity-template-nextjs-clean#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-template-nextjs-clean/issues"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "db:backup": "cd studio && npx sanity dataset export production ../local-prod-backups/production-backup-$(date +%F).tar.gz --overwrite",
    "db:dev": "node scripts/use-dataset.mjs dev",
    "db:prod": "node scripts/use-dataset.mjs production",
    "db:status": "node scripts/use-dataset.mjs status",
    "deploy:studio": "npm run deploy --workspace=studio",
    "predev": "npm run db:status",
    "dev": "npx run-p --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --replace",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces",
    "vercel:deploy:preview": "npx vercel",
    "vercel:deploy:prod": "npx vercel --prod",
    "vercel:env:pull": "cd frontend && npx vercel env pull .env.local",
    "vercel:link": "cd frontend && npx vercel link"
  },
  "prettier": "@sanity/prettier-config",
  "overrides": {
    "@asamuzakjp/dom-selector": "7.0.7"
  },
  "devDependencies": {
    "@asamuzakjp/dom-selector": "7.0.7",
    "@sanity/prettier-config": "^2.0.2",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.7.3"
  }
}
